# Copy this file to .env.local and fill in real values.
# See README.md "Getting started (self-hosting)" and
# specs/001-accounts-invitations/plan.md "Acciones Manuales Requeridas"
# for where to get each of these.

# --- Database (Neon) ---
# Connection string from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/kanban?sslmode=require"

# --- Auth (Better Auth, self-hosted) ---
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Base URL this app is reachable at (used to build OAuth callback / email links).
# Use http://localhost:3000 for local development.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (for "Sign in with Google") ---
# From a Google Cloud Console OAuth 2.0 Client ID ("Web application").
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (Resend) ---
# Used for email verification and password-reset emails.
RESEND_API_KEY=""
# The "from" address Resend sends as (must be a domain verified in Resend,
# or Resend's shared testing domain for local development).
EMAIL_FROM="Kanban <onboarding@resend.dev>"
